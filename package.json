{
  "name": "oc-pos-saas-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "dev:hanyuflow": "npm --workspace=@oc-pos/hanyuflow run dev",
    "build:hanyuflow": "npm --workspace=@oc-pos/hanyuflow run build",
    "build:shared": "npm --workspace=@oc-pos/shared run build",
    "build:database": "npm --workspace=@oc-pos/database run build",
    "build:backend": "npm --workspace=@oc-pos/backend run build",
    "build:web": "npm --workspace=@oc-pos/web run build",
    "build": "npm run build:shared && npm run build:database && npm run build:backend && npm run build:web",
    "test": "node --test packages/shared/dist/**/*.test.js packages/database/dist/**/*.test.js packages/backend/dist/**/*.test.js",
    "lint": "oxlint packages/shared/src packages/database/src packages/backend/src packages/web/src",
    "typecheck": "npm --workspace=@oc-pos/shared run typecheck && npm --workspace=@oc-pos/database run typecheck && npm --workspace=@oc-pos/backend run typecheck && npm --workspace=@oc-pos/web run typecheck"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "lucide-react": "^1.37.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "gh-pages": "^6.3.0",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
